<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    form view -->
    <record id="device_management_device_models_form" model="ir.ui.view">
        <field name="name">device.device.model.form</field>
        <field name="model">device.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_type_id" widget="many2one_tags"/>
                        <field name="device_brand_id" widget="many2one_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    list view for a student-->
    <record id="device_management_device_brand_list_view" model="ir.ui.view">
        <field name="name">device.model.list.view</field>
        <field name="model">device.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_type_id" widget="many2one_tags"/>
                <field name="device_brand_id" widget="many2one_tags"/>
            </list>
        </field>
    </record>

    <record id="device_management_device_models" model="ir.actions.act_window">
        <field name="name">Device Models</field>
        <field name="res_model">device.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>